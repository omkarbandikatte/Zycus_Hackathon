LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=http://localhost:11434

# Optional backup provider: used automatically if the primary provider call fails
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
LLM_BACKUP_PATH=/chat/completions
LLM_BACKUP_PRODUCT=
LLM_BACKUP_FLOWNAME=
LLM_BACKUP_BUNDLENAME=
LLM_BACKUP_USER_ID=
LLM_BACKUP_TENANT_ID=
LLM_BACKUP_EXECUTION_MODE=manual
